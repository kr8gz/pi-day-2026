procedure gaussLegendre(iterations)
    local a, b, p, t, an, bn, pn, tn, i

    a := 1.0
    b := 1.0 / sqrt(2.0)
    p := 1.0
    t := 0.25

    every i := 1 to iterations do {
        an := a
        bn := b
        pn := p
        tn := t

        a := (an + bn) / 2
        b := sqrt(an * bn)
        t := tn - pn * (an - a) ^ 2
        p := 2 * pn
    }
    
    return (a + b) ^ 2 / (4 * t)
end

procedure main()
    write(gaussLegendre(10))
end