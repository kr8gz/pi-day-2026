fun sqrt(n) {
    var x = n;
    var prev = 0;
    while (prev != x) {
        prev = x;
        x = (x + n / x) / 2;
    }
    return x;
}

fun gaussLegendre(iterations) {
    var a = 1;
    var b = 1 / sqrt(2);
    var p = 1;
    var t = 0.25;

    for (var i = 0; i < iterations; i = i + 1) {
        var an = a;

        a = (a + b) / 2;
        b = sqrt(an * b);
        t = t - p * (an - a) * (an - a);
        p = 2 * p;
    }

    return (a + b) * (a + b) / (4 * t);
}

print(gaussLegendre(10));