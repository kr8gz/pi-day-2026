sub GaussLegendre(iterations)
    a = 1.0
    b = 1.0 / sqrt(2.0)
    p = 1.0
    t = 0.25

    for i = 1 to iterations
        an = a

        a = (a + b) / 2
        b = sqrt(an * b)
        t = t - p * (an - a) * (an - a)
        p = 2 * p
    next i

    return (a + b) * (a + b) / (4 * t)
end sub

print GaussLegendre(10)