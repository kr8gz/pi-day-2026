from math import sqrt

fn gauss_legendre(iterations: Int) -> Float64:
    var a: Float64 = 1.0
    var b: Float64 = 1.0 / sqrt(2.0)
    var p: Float64 = 1.0
    var t: Float64 = 0.25

    for _ in range(1, iterations + 1):
        let an = a

        a = (a + b) / 2.0
        b = sqrt(an * b)
        t = t - p * (an - a) ** 2
        p = 2.0 * p
    
    return (a + b) ** 2 / (4.0 * t)

def main():
    print(gauss_legendre(10))